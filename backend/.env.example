# Server Configuration
# Note: Render automatically assigns PORT; in local development, default is 5000
PORT=5000
NODE_ENV=development

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/hospital_appointments
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Remember to whitelist deployment/client IP addresses in MongoDB Atlas Network Access.
MONGO_URI=mongodb://127.0.0.1:27017/hospital_appointments

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# For local development: http://localhost:5173
# For production (e.g., Vercel): https://hospital-appointment-platform-front.vercel.app
# Multiple origins can be separated by commas (e.g. http://localhost:5173,https://your-domain.vercel.app)
CLIENT_URL=http://localhost:5173

# Admin Seeding (Used only by `npm run seed` to create the initial admin account)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please

# Optional: Redis connection URL (caching is disabled when empty)
REDIS_URL=
